<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- .NET Global Tool Ayarları -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>scribe</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>

    <!-- .NET Global Tool Ayarları -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>scribe</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>

    <!-- NuGet Paket Kimliği ve Çift Dilli SEO Açıklaması -->
    <PackageId>CommitScribe</PackageId>
    <Description>CommitScribe is a fast, zero-dependency .NET Global CLI tool that automatically generates clean, categorized CHANGELOG.md and release notes from Conventional Commits (feat, fix, perf, refactor, breaking changes) with automatic GitHub PR linking and file prepending. | CommitScribe; Git geçmişinizdeki Conventional Commits mesajlarını analiz ederek kategorize edilmiş, GitHub PR bağlantılı ve okunabilir CHANGELOG.md ile sürüm notlarını (release notes) otomatik üreten hızlı bir .NET Global CLI aracıdır.</Description>
    <PackageTags>git;changelog;conventional-commits;release-notes;cli;dotnet-tool;markdown;versioning;semantic-release;github;automation;surum-notlari;otomatik-changelog</PackageTags>
    <PackageReleaseNotes>Initial release: Conventional Commits parsing, automatic Git tag range detection, GitHub PR auto-linking, and existing CHANGELOG.md prepending.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
